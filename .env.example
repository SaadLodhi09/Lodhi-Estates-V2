# Copy this file to .env.local and fill in your Supabase project's values.
# Find both on your project's dashboard: Settings -> API.
# The anon key is safe to expose in frontend code — it's public by design,
# and access is enforced by the Row Level Security policies in
# supabase/migrations/0001_init.sql, not by keeping this key secret.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The single email address authorized to access the admin dashboard (/admin).
# No other user account can access the admin panel.
VITE_ADMIN_EMAIL=admin@lodhiestates.com
